{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Static calibrated sensor topology, without actor state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "coordinate_frame",
    "metric_scale_verified",
    "grid_step_native",
    "speed_policy",
    "sensors",
    "scenarios",
    "provenance",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "profile_id": {
      "type": "string"
    },
    "coordinate_frame": {
      "type": "string"
    },
    "metric_scale_verified": {
      "const": false
    },
    "grid_step_native": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "speed_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximum_native_units_per_second",
        "nominal_minimum_moving_speed",
        "units"
      ],
      "properties": {
        "maximum_native_units_per_second": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "nominal_minimum_moving_speed": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "units": {
          "type": "string"
        }
      }
    },
    "sensors": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "scenarios": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "nodes",
          "edges",
          "visibility_masks",
          "portal_assumptions"
        ],
        "properties": {
          "nodes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "number"
              }
            }
          },
          "edges": {
            "type": "array",
            "items": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "prefixItems": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              ],
              "items": false
            }
          },
          "visibility_masks": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            }
          },
          "portal_assumptions": {
            "type": "object",
            "additionalProperties": {
              "enum": [
                "closed",
                "open"
              ]
            }
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "static_context_sha256",
        "scene_sha256",
        "profile_sha256",
        "method"
      ],
      "properties": {
        "static_context_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "scene_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "profile_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "method": {
          "type": "string"
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$comment": "Only static building cells, calibrated sensor priors and explicit door-state assumptions. Never actor IDs, routes, body poses, GT labels or observations."
}
