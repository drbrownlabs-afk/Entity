{
  "$defs": {
    "Member": {
      "additionalProperties": false,
      "properties": {
        "track_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Track Id",
          "type": "string"
        },
        "evidence_observation_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 5000,
          "minItems": 1,
          "title": "Evidence Observation Ids",
          "type": "array"
        }
      },
      "required": [
        "track_id",
        "evidence_observation_ids"
      ],
      "title": "Member",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "global_track_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Global Track Id",
      "type": "string"
    },
    "members": {
      "items": {
        "$ref": "#/$defs/Member"
      },
      "maxItems": 1000,
      "minItems": 1,
      "title": "Members",
      "type": "array"
    },
    "method": {
      "const": "osnet-ain-static-graph-constrained-mtmc",
      "title": "Method",
      "type": "string"
    },
    "model_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Model Sha256",
      "type": "string"
    },
    "graph_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Graph Sha256",
      "type": "string"
    },
    "calibration_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Calibration Sha256",
      "type": "string"
    },
    "association_output_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Association Output Sha256",
      "type": "string"
    },
    "execution_mode": {
      "const": "offline-full-corpus",
      "title": "Execution Mode",
      "type": "string"
    },
    "provisional": {
      "const": true,
      "default": true,
      "title": "Provisional",
      "type": "boolean"
    },
    "probability_calibrated": {
      "const": false,
      "default": false,
      "title": "Probability Calibrated",
      "type": "boolean"
    },
    "gap_location_status": {
      "const": "unknown",
      "default": "unknown",
      "title": "Gap Location Status",
      "type": "string"
    }
  },
  "required": [
    "global_track_id",
    "members",
    "method",
    "model_sha256",
    "graph_sha256",
    "calibration_sha256",
    "association_output_sha256",
    "execution_mode"
  ],
  "title": "GlobalAssociation",
  "type": "object"
}
